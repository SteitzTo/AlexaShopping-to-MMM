    {
        "id": "d2b243338465c090",
        "type": "function",
        "z": "8273dbc837962bbc",
        "name": "Array für Einkauflisten Items KI optimiert",
        "func": "let AlexaArray = msg.payload; // Array of the payload\nconst valuesArray = [];       // Array for filter\n\n// 1. Filtern: Nur unvollständige Elemente\nconst Filter1Array = AlexaArray.filter(element => {\n    return element.completed === false;\n});\n\n// 2. Extrahieren: Text-Werte in das Array pushen (OHNE <br>)\nfor (let i = 0; i < Filter1Array.length; i++) {\n    if (typeof Filter1Array[i] === 'object' && Filter1Array[i].hasOwnProperty('value')) {\n        valuesArray.push(Filter1Array[i].value); // <br> hier entfernt!\n    }\n}\n\n// 3. Formatieren: Ersten Buchstaben großformatieren\nconst capitalizedArray = valuesArray.map(word => {\n    if (!word) return word; // Schutz vor leeren Einträgen\n    return word.charAt(0).toUpperCase() + word.slice(1);\n});\n\n// 4. Zusammenfügen: Hier setzen wir das <br> als Trennzeichen ein!\nconst capitalizedArrayfertig = capitalizedArray.join(\"<br>\");\n\nmsg.payload = capitalizedArrayfertig;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 160,
        "wires": [
            [
                "546edc2bab903506"
            ]
        ]
